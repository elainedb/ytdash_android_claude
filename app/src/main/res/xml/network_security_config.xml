<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic stays HTTPS-only. Cleartext is permitted ONLY for the local mock
         server reachable from the device (emulator loopback 10.0.2.2, or 127.0.0.1/localhost via
         `adb reverse` on a physical device). This is what lets the same build talk to the mock. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
